# Copy this file to .env and change the values if needed.
# Every value below has a sensible default for local development,
# so the API will still start without a .env file.

NODE_ENV=development
PORT=4000

# Local MongoDB. The database is created automatically on first write.
MONGO_URI=mongodb://127.0.0.1:27017/fullstack-todo-app

# Used to sign login tokens. Use a long random string outside local dev.
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# The React app origin, used for CORS.
CLIENT_URL=http://localhost:5173
