{
  "name": "@todo-app/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB REST API for the TODO app.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../packages/shared/src src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "db:migrate": "migrate-mongo up",
    "db:migrate:down": "migrate-mongo down",
    "db:migrate:status": "migrate-mongo status",
    "db:migrate:create": "migrate-mongo create",
    "db:seed": "node seeders/seed-sample-todos.js",
    "db:seed:fresh": "node seeders/seed-sample-todos.js --fresh",
    "test": "NODE_ENV=test node --test --test-concurrency=1 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@todo-app/shared": "1.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
